          <StatisticalMeasure gml:id="stat-sum-PT12H-rr12h---">
            <statisticalFunction>sum</statisticalFunction><aggregationTimePeriod>PT12H</aggregationTimePeriod>
          </StatisticalMeasure>
        </statisticalMeasure>
