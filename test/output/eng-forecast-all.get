      	<basePhenomenon>Cloudiness</basePhenomenon>
      	<uom uom="%"/>
      </ObservableProperty>
    </component>  
    <component>
      <ObservableProperty gml:id="hourlymaximumgust">
        <label>Hourly maximum wind gust</label>
      	<basePhenomenon>Wind</basePhenomenon>
      	<uom uom="m/s"/>
      	<statisticalMeasure>     
          <StatisticalMeasure gml:id="stat-max-PT1H-hourlymaximumgust---">
            <statisticalFunction>max</statisticalFunction><aggregationTimePeriod>PT1H</aggregationTimePeriod>
          </StatisticalMeasure>
        </statisticalMeasure>
      </ObservableProperty>
    </component>  
    <component>
      <ObservableProperty gml:id="humidity">
        <label>Humidity</label>
      	<basePhenomenon>Humidity</basePhenomenon>
      	<uom uom="%"/>
      </ObservableProperty>
    </component>  
