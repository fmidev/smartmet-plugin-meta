          <StatisticalMeasure gml:id="stat-sum-PT6H-surface6haccumulatednhxdrydeposition---">
            <statisticalFunction>sum</statisticalFunction><aggregationTimePeriod>PT6H</aggregationTimePeriod>
          </StatisticalMeasure>
        </statisticalMeasure>
      </ObservableProperty>
