    <component>
      <ObservableProperty gml:id="inversion">
        <label>Occurence of inversion</label>
      	<basePhenomenon>Inversion</basePhenomenon>
      	<uom uom="y / nil"/>
      </ObservableProperty>
    </component>  
    <component>
      <ObservableProperty gml:id="lowcloudcover">
        <label>Low cloud cover</label>
      	<basePhenomenon>Cloudiness</basePhenomenon>
      	<uom uom="%"/>
      </ObservableProperty>
    </component>  
    <component>
      <ObservableProperty gml:id="lvpprob">
        <label>LVP-probability</label>
      	<basePhenomenon>LVP</basePhenomenon>
      	<uom uom="%"/>
      </ObservableProperty>
    </component>  
    <component>
      <ObservableProperty gml:id="maximumwind">
        <label>Maximum wind speed</label>
      	<basePhenomenon>Wind</basePhenomenon>
      	<uom uom="m/s"/>
      	<statisticalMeasure>     
          <StatisticalMeasure gml:id="stat-max-PT1H-maximumwind---">
            <statisticalFunction>max</statisticalFunction><aggregationTimePeriod>PT1H</aggregationTimePeriod>
		<otherAggregation>
                        <StatisticalMeasure gml:id="stat-other-max-PT1H-maximumwind---"><statisticalFunction>avg</statisticalFunction><aggregationTimePeriod>PT10M</aggregationTimePeriod>
                        </StatisticalMeasure>
                    </otherAggregation>
          </StatisticalMeasure>
        </statisticalMeasure>
      </ObservableProperty>
    </component>  
    <component>
      <ObservableProperty gml:id="meanicethickness">
        <label>Mean ice thickness</label>
      	<basePhenomenon>Thickness</basePhenomenon>
      	<uom uom="m"/>
      </ObservableProperty>
    </component>  
    <component>
      <ObservableProperty gml:id="mediumcloudcover">
        <label>Medium cloud cover</label>
      	<basePhenomenon>Cloudiness</basePhenomenon>
      	<uom uom="%"/>
      </ObservableProperty>
