    </component>  
    <component>
      <ObservableProperty gml:id="visibility">
        <label>Visibility</label>
      	<basePhenomenon>Visibility</basePhenomenon>
      	<uom uom="m"/>
      </ObservableProperty>
    </component>  
    <component>
      <ObservableProperty gml:id="visibility2">
        <label>Visibility (Himan)</label>
      	<basePhenomenon>Visibility</basePhenomenon>
      	<uom uom="m"/>
      </ObservableProperty>
