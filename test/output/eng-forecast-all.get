      </ObservableProperty>
    </component>  
    <component>
      <ObservableProperty gml:id="geopheight">
        <label>Geopotential height</label>
      	<basePhenomenon>Height</basePhenomenon>
      	<uom uom="m"/>
      </ObservableProperty>
    </component>  
    <component>
      <ObservableProperty gml:id="h">
        <label>Timestep</label>
      	<basePhenomenon>Time</basePhenomenon>
      	<uom uom="h"/>
      </ObservableProperty>
    </component>  
    <component>
      <ObservableProperty gml:id="hclass">
