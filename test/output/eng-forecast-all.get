    <component>
      <ObservableProperty gml:id="wg">
        <label>10m max wind gust</label>
      	<basePhenomenon>Wind Speed</basePhenomenon>
      	<uom uom="kt"/>
      </ObservableProperty>
    </component>  
    <component>
      <ObservableProperty gml:id="winddirection">
        <label>Wind direction</label>
      	<basePhenomenon>Wind</basePhenomenon>
      	<uom uom="deg"/>
      	<statisticalMeasure>     
          <StatisticalMeasure gml:id="stat-avg-PT1H-winddirection---">
            <statisticalFunction>avg</statisticalFunction><aggregationTimePeriod>PT1H</aggregationTimePeriod>
          </StatisticalMeasure>
        </statisticalMeasure>
      </ObservableProperty>
    </component>  
    <component>
      <ObservableProperty gml:id="windgust">
        <label>Wind gust</label>
      	<basePhenomenon>Wind</basePhenomenon>
      	<uom uom="m/s"/>
      	<statisticalMeasure>     
          <StatisticalMeasure gml:id="stat-max-PT1H-windgust---">
            <statisticalFunction>max</statisticalFunction><aggregationTimePeriod>PT1H</aggregationTimePeriod>
		<otherAggregation>
                        <StatisticalMeasure gml:id="stat-other-max-PT1H-windgust---"><statisticalFunction>avg</statisticalFunction><aggregationTimePeriod>PT3S</aggregationTimePeriod>
                        </StatisticalMeasure>
                    </otherAggregation>
          </StatisticalMeasure>
        </statisticalMeasure>
      </ObservableProperty>
    </component>  
    <component>
