      	<basePhenomenon>Concentration</basePhenomenon>
      	<uom uom="%"/>
      </ObservableProperty>
    </component>  
    <component>
      <ObservableProperty gml:id="icehigh">
        <label>Icing top</label>
      	<basePhenomenon>Icing</basePhenomenon>
      	<uom uom="ft / FL"/>
