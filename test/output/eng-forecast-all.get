      	<basePhenomenon>Cloud</basePhenomenon>
      	<uom uom="ft"/>
      </ObservableProperty>
    </component>  
    <component>
      <ObservableProperty gml:id="totalcloudcover">
        <label>Total cloud cover</label>
      	<basePhenomenon>Cloudiness</basePhenomenon>
      	<uom uom="%"/>
      </ObservableProperty>
    </component>  
    <component>
      <ObservableProperty gml:id="turbhigh">
        <label>Turbulence top</label>
      	<basePhenomenon>Turbulence</basePhenomenon>
      	<uom uom="ft / FL"/>
      </ObservableProperty>
    </component>  
    <component>
      <ObservableProperty gml:id="turbintensity">
